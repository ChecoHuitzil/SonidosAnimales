<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Boton elefante -->
        <ImageButton
            android:id="@+id/btnElefante"
            android:layout_width="180dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/elefante"
            android:scaleType="centerCrop"
            android:background="#FFFFFF"
            android:contentDescription="Sonido de elefante"
            android:padding="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ELEFANTE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- Boton rana -->
        <ImageButton
            android:id="@+id/btnRana"
            android:layout_width="180dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/rana"
            android:scaleType="centerCrop"
            android:background="#FFFFFF"
            android:contentDescription="Sonido de rana"
            android:padding="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RANA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- Boton lobo -->
        <ImageButton
            android:id="@+id/btnLobo"
            android:layout_width="180dp"
            android:layout_height="130dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/lobo"
            android:scaleType="centerCrop"
            android:background="#FFFFFF"
            android:contentDescription="Sonido de lobo"
            android:padding="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOBO"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

    </LinearLayout>
</ScrollView>
